# PostgreSQL connection string. Supabase, Render, Neon and Railway all give you one.
# Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google Gemini key used by the review pipeline.
# Note the name: the code reads GEMINI_API_KEY, not GOOGLE_API_KEY.
GEMINI_API_KEY=

# Comma-separated list of allowed browser origins. Defaults to * (no credentials).
ALLOWED_ORIGINS=https://crabai.vercel.app,http://localhost:3000

# Optional. Hosts usually set this for you.
PORT=10000
